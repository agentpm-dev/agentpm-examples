# Optional: override the CLI used by package scripts.
# AGENTPM=/absolute/path/to/agentpm

# Harness projects this value into the HTTP MCP import request header with
# { "env": "MCP_BRIDGE_AUTHORIZATION" }. Keep real credentials here or in your
# shell environment, never in agentpm.harness.json.
MCP_BRIDGE_AUTHORIZATION=Bearer local-mcp-bridge-token

# The Harness config uses http://127.0.0.1:18241/mcp. If you change this port,
# update agentpm.harness.json as well.
MCP_BRIDGE_PORT=18241
