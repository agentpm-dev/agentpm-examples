{
  "$schema": "https://raw.githubusercontent.com/agentpm-dev/cli/refs/heads/main/schemas/agentpm.manifest.schema.json",
  "kind": "tool",
  "name": "json-transform",
  "version": "0.1.0",
  "description": "Apply deterministic transformation operations to JSON objects and arrays.",
  "files": [
    "json_transform/",
    "tests/",
    "README.md"
  ],
  "entrypoint": {
    "command": "python",
    "args": [
      "-u",
      "json_transform/__main__.py"
    ],
    "timeout_ms": 30000
  },
  "runtime": {
    "type": "python",
    "version": "3.11"
  },
  "inputs": {
    "type": "object",
    "properties": {
      "input": {},
      "operations": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "required": [
      "input",
      "operations"
    ],
    "additionalProperties": false
  },
  "outputs": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "result": {},
          "applied_operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ok",
          "result",
          "applied_operations",
          "validation_errors"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  },
  "readme": "README.md"
}
