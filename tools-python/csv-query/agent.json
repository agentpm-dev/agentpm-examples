{
  "$schema": "https://raw.githubusercontent.com/agentpm-dev/cli/refs/heads/main/schemas/agentpm.manifest.schema.json",
  "kind": "tool",
  "name": "csv-query",
  "version": "0.1.0",
  "description": "Query CSV data with structured filter, sort, select, and aggregate operations.",
  "files": [
    "csv_query/"
  ],
  "entrypoint": {
    "command": "python",
    "args": [
      "-u",
      "csv_query/__main__.py"
    ],
    "timeout_ms": 30000
  },
  "runtime": {
    "type": "python",
    "version": "3.11"
  },
  "inputs": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "csv_text": {
        "type": "string"
      },
      "select": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "filter": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "sort": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "limit": {
        "type": "integer",
        "minimum": 1
      },
      "group_by": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "aggregations": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "additionalProperties": false
  },
  "outputs": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "row_count": {
            "type": "integer"
          },
          "summary": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "ok",
          "columns",
          "rows",
          "row_count",
          "summary"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      }
    ]
  },
  "readme": "README.md"
}
