{
  "version": 1,
  "model": {
    "provider": "openai",
    "model": "gpt-4o-mini"
  },
  "memory": {
    "runtimes": {
      "redis-memory-reference": {
        "implementation": {
          "type": "process",
          "command": "node",
          "args": ["../providers/node/redis-runtime.mjs"],
          "env": [
            "AGENTPM_MEMORY_RUNTIME_ID",
            "AGENTPM_MEMORY_PACKAGE",
            "AGENTPM_MEMORY_VERSION",
            "AGENTPM_MEMORY_REDIS_STACK",
            "REDIS_URL"
          ],
          "startup_timeout_ms": 15000,
          "request_timeout_ms": 120000
        }
      }
    },
    "packages": {
      "@zack/m16-reference-memory": {
        "runtime": "redis-memory-reference"
      }
    }
  },
  "runtime": {
    "limits": {
      "max_steps": 8,
      "max_model_calls_per_phase": 6,
      "max_tool_calls_per_phase": 1,
      "max_actions_per_phase": 12,
      "max_tool_call_repairs": 1,
      "max_structured_output_repairs": 4
    }
  },
  "trace": {
    "enabled": true,
    "level": "verbose",
    "content": "full"
  }
}
