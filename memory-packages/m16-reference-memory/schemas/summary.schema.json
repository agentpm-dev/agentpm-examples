{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpm.dev/examples/m16/schemas/summary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "x-agentpm-persist": true
    },
    "source_count": {
      "type": "integer",
      "minimum": 1,
      "x-agentpm-persist": true
    }
  }
}
