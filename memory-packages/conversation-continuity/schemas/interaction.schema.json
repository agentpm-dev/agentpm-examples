{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interaction",
  "description": "One ordered interaction inside a conversation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "speaker": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "tool"
      ],
      "x-agentpm-data-class": "operational",
      "x-agentpm-persist": true,
      "x-agentpm-sensitivity": "low",
      "x-agentpm-shareable": true
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "x-agentpm-data-class": "operational",
      "x-agentpm-persist": true,
      "x-agentpm-sensitivity": "moderate",
      "x-agentpm-shareable": true
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "x-agentpm-data-class": "operational",
      "x-agentpm-persist": true,
      "x-agentpm-sensitivity": "low",
      "x-agentpm-shareable": true
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "x-agentpm-data-class": "operational",
      "x-agentpm-persist": true,
      "x-agentpm-sensitivity": "moderate",
      "x-agentpm-shareable": true
    }
  },
  "required": [
    "speaker",
    "text"
  ]
}
