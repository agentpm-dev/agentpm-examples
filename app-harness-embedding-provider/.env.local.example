# Required for the built-in OpenAI model provider and the local embedding host.
OPENAI_API_KEY=

# Optional: point at a local CLI build while developing this example.
AGENTPM=agentpm

# Optional: user scope sent by the SDK host when launching Harness.
SDK_HOST_USER=embedding-provider-user

# Optional: OpenAI-compatible embeddings endpoint.
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
