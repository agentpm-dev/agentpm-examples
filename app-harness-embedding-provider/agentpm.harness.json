{
  "version": 1,
  "model": {
    "provider": "openai",
    "model": "gpt-4o-mini"
  },
  "providers": {
    "embeddings": {
      "local-openai-embeddings": {
        "implementation": {
          "type": "process",
          "command": "node",
          "args": [
            "runtime/openai-embedding-provider.mjs"
          ],
          "cwd": ".",
          "env": [
            "OPENAI_API_KEY",
            "OPENAI_EMBEDDING_BASE_URL"
          ],
          "request_timeout_ms": 120000
        }
      }
    }
  },
  "scopes": {
    "user": "embedding-provider-user"
  },
  "knowledge": {
    "embedding_matches": [
      {
        "match": {
          "provider": "openai",
          "model": "text-embedding-3-small",
          "dimensions": 1536,
          "normalized": true
        },
        "embedding_provider": "local-openai-embeddings"
      }
    ]
  },
  "trace": {
    "level": "normal",
    "content": "redacted"
  },
  "ui": {
    "branding": {
      "name": "Harness Embedding Provider",
      "subtitle": "Embedding provider host"
    }
  }
}
