{
  "version": 1,
  "model": {
    "provider": "openai",
    "model": "{{ openai_model }}"
  },
  "scopes": {
    "user": "{{ default_user_scope }}",
    "repository": "{{ default_repository_scope }}"
  },
  "runtime": {
    "state_dir": ".agentpm-state"
  },
  "trace": {
    "enabled": true,
    "level": "normal",
    "content": "redacted"
  },
  "ui": {
    "branding": {
      "name": "{{ workspace_label }}",
      "subtitle": "Minimal Harness Agent",
      "accent": "#0EA5E9"
    }
  }
}
