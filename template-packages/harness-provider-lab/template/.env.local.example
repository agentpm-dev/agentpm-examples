# Optional: override the CLI used by README commands.
# AGENTPM=/absolute/path/to/agentpm

# Required for the process EmbeddingProvider. Keep real credentials in this
# local file or your shell environment, never in agentpm.harness.json.
OPENAI_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1

# Optional labels used by the reference process providers.
PROVIDER_LAB_MODEL_ID=provider-lab-model
PROVIDER_LAB_KNOWLEDGE_RUNTIME_ID=reference-knowledge
PROVIDER_LAB_MEMORY_RUNTIME_ID=reference-memory
